<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
</head>

<body style="margin:0; padding:0; background-color:#f3f6fb; font-family:Arial,Helvetica,sans-serif; color:#1f2937;">

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
    style="background-color:#f3f6fb; padding:32px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="600" cellspacing="0" cellpadding="0"
          style="width:100%; max-width:600px; background-color:#ffffff; border-radius:12px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#2563eb; padding:30px 20px;">
              <h1 style="margin:0; color:#ffffff; font-size:30px; letter-spacing:1px;">
                Tripora
              </h1>
              <p style="margin:8px 0 0; color:#dbeafe; font-size:14px;">
                Operator Notifications & Updates
              </p>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding:32px 28px;">

              <p style="font-size:15px; line-height:1.8; margin:0 0 20px;">
                Hello {{firstName}},
              </p>

              <h2 style="margin:0 0 18px; color:#111827; font-size:23px; line-height:1.4;">
                {{title}}
              </h2>

              <p style="font-size:15px; line-height:1.9; margin:0 0 20px; color:#4b5563;">
                We are contacting you to inform you about an important update
                related to your Tripora operator account or tour listings.
              </p>

              <!-- Notification Message -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                style="background-color:#eff6ff; border-left:4px solid #2563eb; border-radius:4px;">
                <tr>
                  <td style="padding:20px;">
                    <p style="margin:0 0 10px; font-size:13px; font-weight:bold; color:#1d4ed8; text-transform:uppercase; letter-spacing:0.5px;">
                      Notification Details
                    </p>

                    <p style="margin:0; font-size:15px; line-height:1.9; color:#1e3a8a;">
                      {{message}}
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Guidance -->
              <h3 style="margin:26px 0 10px; color:#111827; font-size:17px;">
                What should you do next?
              </h3>

              <p style="font-size:14px; line-height:1.9; margin:0 0 14px; color:#4b5563;">
                We recommend signing in to your Tripora Operator Dashboard to
                review your account notifications, check the status of your
                tour listings, and manage any other tours or bookings that
                require your attention.
              </p>

              <p style="font-size:14px; line-height:1.9; margin:0 0 20px; color:#4b5563;">
                Keeping your tour information accurate and up to date helps
                travelers make informed decisions and supports a reliable
                experience across the Tripora platform.
              </p>

              <!-- Dashboard Information -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                style="background-color:#f8fafc; border:1px solid #e5e7eb; border-radius:8px;">
                <tr>
                  <td style="padding:18px;">
                    <p style="margin:0 0 8px; font-size:15px; font-weight:bold; color:#111827;">
                      Your Operator Dashboard
                    </p>

                    <p style="margin:0; font-size:14px; line-height:1.8; color:#4b5563;">
                      Access your dashboard to review tour listings, monitor
                      booking activity, manage your operator profile, and
                      check relevant account updates.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Support -->
              <h3 style="margin:26px 0 10px; color:#111827; font-size:17px;">
                Need assistance?
              </h3>

              <p style="font-size:14px; line-height:1.9; margin:0 0 20px; color:#4b5563;">
                If you have questions about this notification or believe
                further clarification is needed, please contact Tripora
                support through the available support channels. Our team
                can help you understand the update and the next steps.
              </p>

              <!-- Closing -->
              <p style="font-size:15px; line-height:1.8; margin:24px 0 0; color:#374151;">
                Thank you for being part of Tripora and for contributing
                to meaningful travel experiences for our community.
              </p>

              <p style="font-size:15px; line-height:1.8; margin:20px 0 0; color:#374151;">
                Best regards,<br />
                <strong>The Tripora Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="background-color:#f8fafc; padding:22px 20px; border-top:1px solid #e5e7eb;">

              <p style="margin:0 0 8px; font-size:12px; line-height:1.7; color:#6b7280;">
                This is an automated notification from Tripora.
                Please do not reply directly to this email.
              </p>

              <p style="margin:0 0 8px; font-size:12px; line-height:1.7; color:#6b7280;">
                For assistance, please use the official Tripora support channels.
              </p>

              <p style="margin:0; font-size:12px; color:#9ca3af;">
                &copy; {{year}} Tripora. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
